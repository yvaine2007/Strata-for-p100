# syntax=docker/dockerfile:1

ARG BASE_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04

# ==========================================
# 阶段 1: 编译引擎并调用官方脚本打包 (Engine Build & Package)
# ==========================================
FROM ${BASE_IMAGE} AS engine-build
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates git libatomic1 libgomp1 \
        python3 python3-pip python3-venv unzip wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

ARG CUDA_ARCHITECTURES=60
ARG BUILD_VISION=1

RUN python3 -m venv /venv \
    && /venv/bin/pip install --no-cache-dir --upgrade pip \
    && /venv/bin/pip install --no-cache-dir -r requirements.txt

RUN /venv/bin/python - <<'PYEOF'
import json, os, pathlib, shutil, subprocess
import setup

llama = setup.get_llama_cpp()
nvcc, _ = setup.find_nvcc(below=(13, 0))
if nvcc is None:
    raise SystemExit("no CUDA 12.x toolkit found; the sm_60 build needs one")

arch = os.environ.get("CUDA_ARCHITECTURES", "60").strip().strip('"').replace(",", ";")
vision = "gpu" if os.environ.get("BUILD_VISION", "1") == "1" else "none"

# 1. 编译核心引擎
setup.cmake_build(setup.ROOT, setup.ROOT / "build-cuda12", "strata",
    ["-DSTRATA_ENABLE_CUDA=ON", "-DSTRATA_BUILD_TESTS=OFF", "-DSTRATA_EXPERIMENTAL_SM60=ON",
     "-DSTRATA_PORTABLE=ON", "-DSTRATA_NATIVE_EXPERTS=ON", "-DSTRATA_Q6K_EXPERTS=ON",
     "-DSTRATA_MMQ_KQUANTS=ON", f"-DCMAKE_CUDA_ARCHITECTURES={arch}",
     f"-DCMAKE_CUDA_COMPILER={nvcc}", f"-DSTRATA_GGML_DIR={llama}"], None, "build-strata.bat")

# 2. 编译视觉模型 (关闭 NCCL)
if vision != "none":
    setup.cmake_build(setup.ROOT / "tools" / "vision", setup.ROOT / "build-vision-cuda12", "strata-vision",
        [f"-DLLAMA_DIR={llama}", "-DSTRATA_VISION_CUDA=ON", "-DSTRATA_PORTABLE=ON",
         "-DSTRATA_EXPERIMENTAL_SM60=ON", "-DGGML_CUDA_NCCL=OFF",
         f"-DCMAKE_CUDA_ARCHITECTURES={arch}",
         f"-DCMAKE_CUDA_COMPILER={nvcc}"], None, "build-vision.bat")

# 3. 准备打包目录
stage = pathlib.Path("/stage")
stage.mkdir(exist_ok=True)
shutil.copy2(setup.ROOT / "build-cuda12" / setup.EXE, stage / setup.EXE)
if vision != "none":
    shutil.copy2(setup.ROOT / "build-vision-cuda12" / "bin" / setup.VEXE, stage / setup.VEXE)

kq_lib = setup.ROOT / "build-cuda12" / "libstrata_kq.so"
if kq_lib.exists():
    shutil.copy2(kq_lib, stage / "libstrata_kq.so")

# 4. 收集依赖
# 因为之前加了 --ignore 报错，这次去掉 --ignore。
# 并且显式传入 CUDA 库的搜索路径，确保 libcublas 和 libcudart 能被找到并拷入 /stage
cuda_lib_dir = str(pathlib.Path(nvcc).resolve().parent.parent / "lib64")
try:
    subprocess.run([
        "python3", "packaging/collect_libs.py", 
        "--binary", "build-cuda12/strata", 
        "--search", cuda_lib_dir, 
        "--out", "/stage", 
        "--also", "libcublasLt.so*"
    ], check=True)
except subprocess.CalledProcessError:
    # 如果因为某些奇奇怪怪的系统库报错，不要让它导致整个构建失败，直接继续
    print("Warning: collect_libs.py returned an error, continuing anyway.")

archs_args = []
for a in arch.split(";"):
    if a.isdigit():
        archs_args.extend(["--arch", f"sm_{a}"])
last_arch = [a for a in arch.split(";") if a.isdigit()][-1]

# 5. 调用官方 package_engine.py 打包
cmd = ["python3", "packaging/package_engine.py", "--src", "/stage", "--backend", "cuda", "--version", setup.source_version(), "--out", "/engine"] + archs_args + [
    "--arch", f"compute_{last_arch}", "--min-driver", "nvidia=525.60", "--variant", "cuda12", "--platform", "linux-x86_64",
    "--build-id", "docker-source-p100", "--include", "SYSTEM-LIBS.txt", "--include", "libstrata_kq*", "--include", "strata-vision"
]
subprocess.run(cmd, check=True)
PYEOF

# ==========================================
# 阶段 2: 生成 Terminal (官方原版脚本)
# ==========================================
FROM ubuntu:24.04 AS terminal
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates wget && rm -rf /var/lib/apt/lists/*

COPY --from=engine-build /src /src/
RUN python3 /src/packaging/package_terminal.py --out /out --cache /cache \
    && mkdir -p /opt/strata \
    && tar -xzf /out/strata-terminal-*-linux-x86_64.tar.gz -C /opt/strata --strip-components=1 \
    && /opt/strata/bin/strata --version

# ==========================================
# 阶段 3: 最终运行镜像
# ==========================================
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        tini ca-certificates libgomp1 libatomic1 libnuma1 zlib1g curl wget \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# 直接复制官方格式的 Terminal 和 Engine 包
COPY --from=terminal /opt/strata /opt/strata/terminal
COPY --from=engine-build /engine/ /opt/strata/components/engine/

COPY docker/entrypoint.sh docker/healthcheck.sh /opt/strata/
COPY docker/strata-wrapper.sh /usr/local/bin/strata
RUN chmod 0755 /opt/strata/entrypoint.sh /opt/strata/healthcheck.sh /usr/local/bin/strata

ENV STRATA_COMPONENTS_DIR=/opt/strata/components \
    STRATA_INSTALL_DIR=/data/install \
    XDG_STATE_HOME=/data/state \
    XDG_CONFIG_HOME=/data/config \
    HOME=/data/home \
    PORT=8080 LANG=C.UTF-8 PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1 STRATA_IN_DOCKER=1 \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility

VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=8s --start-period=2h --retries=3 CMD ["/opt/strata/healthcheck.sh"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/strata/entrypoint.sh"]
CMD ["run"]
