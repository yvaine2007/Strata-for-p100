# syntax=docker/dockerfile:1

ARG BASE_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04

# ==========================================
# 阶段 1: 编译引擎
# ==========================================
FROM ${BASE_IMAGE} AS engine-build
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates git libatomic1 libgomp1 \
        python3 python3-pip python3-venv unzip wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/strata
COPY . .

ARG STRATA_VERSION=v0.2.1
ARG CUDA_ARCHITECTURES=60
ARG BUILD_VISION=1

RUN echo "=== Downloading Strata ${STRATA_VERSION} source ===" && \
    wget -qO- "https://github.com/Niko1221/Strata/archive/refs/tags/${STRATA_VERSION}.tar.gz" | tar -xz --strip-components=1

RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir --upgrade pip \
    && .venv/bin/pip install --no-cache-dir -r requirements.txt

RUN .venv/bin/python - <<'PYEOF'
import json, os, pathlib, shutil
import setup

llama = setup.get_llama_cpp()
nvcc, _ = setup.find_nvcc(below=(13, 0))
arch = os.environ.get("CUDA_ARCHITECTURES", "60").strip().strip('"').replace(",", ";")
vision = "gpu" if os.environ.get("BUILD_VISION", "1") == "1" else "none"

setup.cmake_build(setup.ROOT, setup.ROOT / "build-cuda12", "strata",
    ["-DSTRATA_ENABLE_CUDA=ON", "-DSTRATA_BUILD_TESTS=OFF", "-DSTRATA_EXPERIMENTAL_SM60=ON",
     "-DSTRATA_PORTABLE=ON", "-DSTRATA_NATIVE_EXPERTS=ON", "-DSTRATA_Q6K_EXPERTS=ON",
     "-DSTRATA_MMQ_KQUANTS=ON", f"-DCMAKE_CUDA_ARCHITECTURES={arch}",
     f"-DCMAKE_CUDA_COMPILER={nvcc}", f"-DSTRATA_GGML_DIR={llama}"], None, "build-strata.bat")

if vision != "none":
    setup.cmake_build(setup.ROOT / "tools" / "vision", setup.ROOT / "build-vision-cuda12", "strata-vision",
        [f"-DLLAMA_DIR={llama}", "-DSTRATA_VISION_CUDA=ON", "-DSTRATA_PORTABLE=ON",
         "-DSTRATA_EXPERIMENTAL_SM60=ON", f"-DCMAKE_CUDA_ARCHITECTURES={arch}",
         f"-DCMAKE_CUDA_COMPILER={nvcc}"], None, "build-vision.bat")

# 整合引擎包格式 (符合原版 package_engine.py 的预期)
eng = setup.ROOT / "engine-cuda12"
eng.mkdir(exist_ok=True)
shutil.copy2(setup.ROOT / "build-cuda12" / setup.EXE, eng / setup.EXE)
if vision != "none":
    shutil.copy2(setup.ROOT / "build-vision-cuda12" / "bin" / setup.VEXE, eng / setup.VEXE)

kq_lib = setup.ROOT / "build-cuda12" / "libstrata_kq.so"
if kq_lib.exists():
    shutil.copy2(kq_lib, eng / "libstrata_kq.so")

# 给原版 verify 阶段用的必要文件
bindir = pathlib.Path(nvcc).parent
meta = {
    "source": "local",
    "version": os.environ.get("STRATA_VERSION", "unknown").lstrip("v"),
    "archs": [int(a.split("-")[0]) for a in arch.split(";") if a.split("-")[0].isdigit()],
    "vision": vision,
    "cuda_dirs": [str(d) for d in (bindir, bindir / "x64", bindir.parent / "lib64") if d.is_dir()],
    "src": setup.source_hash(setup.ENGINE_SOURCES),
    "vision_src": setup.source_hash(setup.VISION_SOURCES) if vision != "none" else None,
    "toolkit": 12,
}
(eng / "BUILD.json").write_text(json.dumps(meta, indent=1))
(eng / "engine-component.json").write_text(json.dumps({"flavor": "cuda12", **meta}, indent=1))
PYEOF

# ==========================================
# 阶段 2: 生成 Terminal
# ==========================================
FROM ubuntu:24.04 AS terminal
ARG STRATA_VERSION
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates wget && rm -rf /var/lib/apt/lists/*

# 官方在 releases 里确实没有放独立 tar.gz，我们在原版里直接使用源码包打包
COPY --from=engine-build /opt/strata /opt/strata
RUN python3 /opt/strata/packaging/package_terminal.py --out /out --cache /cache \
    && mkdir -p /opt/strata/terminal \
    && tar -xzf /out/strata-terminal-*-linux-x86_64.tar.gz -C /opt/strata/terminal --strip-components=1 \
    && /opt/strata/terminal/bin/strata --version

# ==========================================
# 阶段 3: 最终运行镜像 (自带 CUDA 12.8 运行库)
# ==========================================
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends tini ca-certificates libgomp1 libatomic1 libnuma1 zlib1g curl wget && rm -rf /var/lib/apt/lists/*

COPY --from=terminal /opt/strata/terminal /opt/strata/terminal
COPY --from=engine-build /opt/strata/engine-cuda12 /opt/strata/components/engine/engine-cuda12
COPY docker/entrypoint.sh docker/healthcheck.sh /opt/strata/
COPY docker/strata-wrapper.sh /usr/local/bin/strata

RUN chmod 0755 /opt/strata/entrypoint.sh /opt/strata/healthcheck.sh /usr/local/bin/strata

ENV STRATA_COMPONENTS_DIR=/opt/strata/components \
    STRATA_INSTALL_DIR=/data/install \
    XDG_STATE_HOME=/data/state \
    XDG_CONFIG_HOME=/data/config \
    HOME=/data/home \
    PORT=8080 LANG=C.UTF-8 PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1 STRATA_IN_DOCKER=1 \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility

VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=8s --start-period=2h --retries=3 CMD ["/opt/strata/healthcheck.sh"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/strata/entrypoint.sh"]
CMD ["run"]
